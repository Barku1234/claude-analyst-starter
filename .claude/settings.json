{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git pull*)",
      "Bash(python*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(npm install*)",
      "Bash(npx*)",
      "Bash(node*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl * | *sh)",
      "Bash(wget * | *sh)"
    ]
  },
  "env": {
    "CLAUDE_STARTER_KIND": "analyst"
  },
  "recommendedPlugins": [
    "superpowers"
  ],
  "recommendedSkills": [
    "document-skills:xlsx",
    "document-skills:pptx",
    "document-skills:docx",
    "document-skills:pdf",
    "deep-research",
    "artifact-design",
    "frontend-design",
    "dataviz",
    "superpowers:writing-plans",
    "superpowers:brainstorming"
  ],
  "recommendedMcps": [
    {
      "name": "playwright",
      "install": "npx -y @modelcontextprotocol/server-playwright",
      "purpose": "Web research: SEC EDGAR, IR pages, news"
    }
  ]
}
